# Copiar a .env y completar con los valores reales del proyecto de Supabase.
# Ver docs/01-requerimientos-y-arquitectura.md sección 0 (esto es una demo:
# Mercado Pago en sandbox, sin credenciales reales de producción).

# --- Base de datos (Supabase Postgres) ---
# Pooled (pgbouncer, puerto 6543) — usada en runtime por el driver adapter
# de Prisma Client (src/lib/prisma.ts), ideal para funciones serverless (Vercel).
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Directa (puerto 5432) — usada solo por la Prisma CLI (prisma.config.ts) para
# `migrate`/`db push`/`studio`. Necesaria porque pgbouncer en modo transacción
# no soporta las operaciones DDL que corren las migraciones.
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Supabase (cliente admin, usado en el servidor solo para Storage) ---
# La autenticación (Fase 1) es Auth.js contra la tabla User propia, no
# Supabase Auth — ver docs/ADR/0001-stack-tecnico.md.
# Claves nuevas de Supabase (reemplazan anon/service_role): Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."

# --- Auth.js (Fase 1) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (ojo: `npx auth secret` NO es esto — ese nombre de paquete en npm hoy es la
# CLI de una librería distinta, "better-auth", no la de Auth.js/NextAuth).
AUTH_SECRET="..."
AUTH_TRUST_HOST="true"

# --- App (Fase 3) ---
# URL absoluta pública de la app — Mercado Pago la necesita para back_urls y
# notification_url (no puede llamar a localhost). En local, exponer con un
# túnel (ngrok/cloudflared) si se quiere probar el webhook real de punta a punta.
APP_URL="http://localhost:3000"

# --- Mercado Pago sandbox (Fase 3) ---
# Ambos desde el panel de desarrolladores de Mercado Pago > Tus integraciones.
MERCADOPAGO_ACCESS_TOKEN="TEST-..."
MERCADOPAGO_WEBHOOK_SECRET="..."
