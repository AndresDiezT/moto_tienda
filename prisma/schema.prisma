// Prisma schema — MiMotoTienda
// Fuente de verdad del modelo: docs/ARCHITECTURE/modelo-de-datos.md
// Convención: campos en camelCase (coincide con los contratos de docs/CONTRACTS-API/),
// mapeados a columnas snake_case en la base de datos vía @map/@@map.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  customer
  mechanic
  admin
}

enum ServiceOrderStatus {
  received
  diagnosing
  quote_sent
  approved
  in_repair
  quality_check
  ready_for_pickup
  delivered
}

enum QuoteStatus {
  pending
  approved
  rejected
}

enum OrderStatus {
  pending_payment
  paid
  preparing
  ready_or_shipped
  delivered
  cancelled
}

enum DeliveryMethod {
  pickup
  delivery
}

enum PaymentProvider {
  mercadopago
  // Pago presencial en el taller (efectivo/datáfono físico), registrado a
  // mano por el admin — ver ADR-0004, sección de refinamiento sobre pago
  // presencial. No pasa por Mercado Pago ni por el webhook.
  cash
}

enum PaymentStatus {
  pending
  approved
  rejected
  cancelled
}

enum InvoiceSeries {
  store
  service
}

enum InvoiceStatus {
  issued
  voided
}

// ---------------------------------------------------------------------------
// Usuarios y cuentas (Épica 1)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  phone        String
  role         Role     @default(customer)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  vehicles                Vehicle[]            @relation("VehicleOwner")
  addresses               Address[]
  orders                  Order[]
  serviceOrdersAsCustomer ServiceOrder[]       @relation("ServiceOrderCustomer")
  serviceOrdersAsMechanic ServiceOrder[]       @relation("ServiceOrderMechanic")
  serviceOrderEvents      ServiceOrderEvent[]  @relation("ServiceOrderEventAuthor")
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

// No estaba en docs/ARCHITECTURE/modelo-de-datos.md (que no cubre
// recuperación de contraseña) — se agrega en Fase 1 para HU-01.5. El token
// se guarda hasheado (nunca en texto plano) y es de un solo uso.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Seguimiento de vehículos (Épica 3)
// ---------------------------------------------------------------------------

model Vehicle {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  owner     User     @relation("VehicleOwner", fields: [ownerId], references: [id])
  brand     String
  model     String
  year      Int
  plate     String
  vin       String?
  createdAt DateTime @default(now()) @map("created_at")

  serviceOrders ServiceOrder[]

  // Regla 5 (modelo-de-datos.md): la placa es única por dueño, no globalmente.
  @@unique([ownerId, plate])
  @@map("vehicles")
}

model ServiceOrder {
  id                 String             @id @default(uuid()) @db.Uuid
  vehicleId          String             @map("vehicle_id") @db.Uuid
  vehicle            Vehicle            @relation(fields: [vehicleId], references: [id])
  customerId         String             @map("customer_id") @db.Uuid
  customer           User               @relation("ServiceOrderCustomer", fields: [customerId], references: [id])
  mechanicId         String?            @map("mechanic_id") @db.Uuid
  mechanic           User?              @relation("ServiceOrderMechanic", fields: [mechanicId], references: [id])
  status             ServiceOrderStatus @default(received)
  problemDescription String             @map("problem_description")
  estimatedCost      Decimal?           @map("estimated_cost") @db.Decimal(12, 2)
  finalCost          Decimal?           @map("final_cost") @db.Decimal(12, 2)
  quoteStatus        QuoteStatus?       @map("quote_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  events   ServiceOrderEvent[]
  payments Payment[]

  @@map("service_orders")
}

// Historial inmutable (regla 1, modelo-de-datos.md): solo insert, nunca
// update/delete — se aplica a nivel de aplicación (sin endpoints de
// edición/borrado sobre este recurso), no como restricción de esquema.
model ServiceOrderEvent {
  id             String             @id @default(uuid()) @db.Uuid
  serviceOrderId String             @map("service_order_id") @db.Uuid
  serviceOrder   ServiceOrder       @relation(fields: [serviceOrderId], references: [id])
  status         ServiceOrderStatus
  note           String?
  photos         String[]
  authorId       String             @map("author_id") @db.Uuid
  author         User               @relation("ServiceOrderEventAuthor", fields: [authorId], references: [id])
  createdAt      DateTime           @default(now()) @map("created_at")

  @@map("service_order_events")
}

// ---------------------------------------------------------------------------
// Tienda en línea (Épica 2)
// ---------------------------------------------------------------------------

model Category {
  id   String @id @default(uuid()) @db.Uuid
  name String

  products Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String
  price       Decimal  @db.Decimal(12, 2)
  stock       Int
  categoryId  String   @map("category_id") @db.Uuid
  category    Category @relation(fields: [categoryId], references: [id])
  images      String[]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@map("products")
}

model Address {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  line1     String
  city      String
  reference String?
  createdAt DateTime @default(now()) @map("created_at")

  orders Order[]

  @@map("addresses")
}

model Order {
  id             String         @id @default(uuid()) @db.Uuid
  customerId     String         @map("customer_id") @db.Uuid
  customer       User           @relation(fields: [customerId], references: [id])
  status         OrderStatus    @default(pending_payment)
  deliveryMethod DeliveryMethod @map("delivery_method")
  addressId      String?        @map("address_id") @db.Uuid
  address        Address?       @relation(fields: [addressId], references: [id])
  shippingCost   Decimal        @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  subtotal       Decimal        @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  items    OrderItem[]
  payments Payment[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  order     Order   @relation(fields: [orderId], references: [id])
  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)

  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Pagos y facturación simulada (ADR-0002, ADR-0004, Épica 5)
// ---------------------------------------------------------------------------

// Regla 2 (modelo-de-datos.md): orderId y serviceOrderId son mutuamente
// excluyentes — exactamente uno debe estar presente. Se valida a nivel de
// aplicación; agregar además un CHECK a nivel de base de datos vía migración
// SQL manual una vez conectada la base de datos (Prisma no expresa CHECK
// constraints arbitrarios en el schema).
model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  provider          PaymentProvider @default(mercadopago)
  externalReference String?         @map("external_reference")
  status            PaymentStatus   @default(pending)
  amount            Decimal         @db.Decimal(12, 2)
  orderId           String?         @map("order_id") @db.Uuid
  order             Order?          @relation(fields: [orderId], references: [id])
  serviceOrderId    String?         @map("service_order_id") @db.Uuid
  serviceOrder      ServiceOrder?   @relation(fields: [serviceOrderId], references: [id])
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  invoice Invoice?

  @@map("payments")
}

model Invoice {
  id        String        @id @default(uuid()) @db.Uuid
  paymentId String        @unique @map("payment_id") @db.Uuid
  payment   Payment       @relation(fields: [paymentId], references: [id])
  number    String        @unique
  series    InvoiceSeries
  provider  String        @default("simulado")
  cufe      String?
  pdfUrl    String        @map("pdf_url")
  status    InvoiceStatus @default(issued)
  issuedAt  DateTime      @default(now()) @map("issued_at")

  @@map("invoices")
}
